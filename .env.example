# Web Push (VAPID) — generate with: pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nba-score@localhost

# External cron auth for GET /api/push/check (serverless only; local dev
# runs its own timer). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Vercel KV (production only; omit for local dev which uses data/push.json).
# Auto-provided when you attach Storage → KV in the Vercel dashboard.
KV_REST_API_URL=
KV_REST_API_TOKEN=
